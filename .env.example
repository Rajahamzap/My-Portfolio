# Copy to .env on the server (never commit real values, never put them in frontend code).
PORT=3000
# Public address of the site, used in password-reset links. Example: https://www.yourdomain.com
PUBLIC_URL=
# Set to true when the site is served over HTTPS directly (not needed behind a proxy that sends X-Forwarded-Proto: https)
COOKIE_SECURE=false
# Optional: custom database location (keep it on a persistent disk)
CMS_DB=
# --- Email (optional but recommended): contact notifications + password reset emails via Resend ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # your inbox for contact form notifications
CONTACT_FROM_EMAIL=          # sender on a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>"
SEND_ACK=false               # true = also email the sender a short acknowledgment
ALLOWED_ORIGIN=              # optional, e.g. https://www.yourdomain.com
# --- First run only (when no database exists yet) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
